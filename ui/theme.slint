// Colour roles, motion tokens and Material Symbols codepoints.

import "../assets/files-symbols.ttf";
import "../assets/files-symbols-fill.ttf";
import "../assets/GoogleSans-Regular.ttf";
import "../assets/GoogleSans-Medium.ttf";

// Material 3 colour roles; Rust overwrites these from the DankMaterialShell / matugen palette.
export global Pal {
    in-out property <bool> dark: true;
    in-out property <color> surface: #0b151a;
    in-out property <color> surface-container-lowest: #060f14;
    in-out property <color> surface-container-low: #131d22;
    in-out property <color> surface-container: #182126;
    in-out property <color> surface-container-high: #222b31;
    in-out property <color> surface-container-highest: #2d363c;
    in-out property <color> on-surface: #dae4ec;
    in-out property <color> on-surface-variant: #bec8d0;
    in-out property <color> primary: #7ad0ff;
    in-out property <color> on-primary: #003549;
    in-out property <color> primary-container: #004c69;
    in-out property <color> on-primary-container: #c3e8ff;
    in-out property <color> secondary-container: #314962;
    in-out property <color> on-secondary-container: #d0e4ff;
    in-out property <color> tertiary: #b4c5f8;
    in-out property <color> outline: #889299;
    in-out property <color> outline-variant: #3e484f;
    in-out property <color> error: #ffb4ab;
    in-out property <color> inverse-surface: #dae4ec;
    in-out property <color> inverse-on-surface: #283238;
    in-out property <color> inverse-primary: #00668a;

    // Drive-style chrome: the window is the "low" surface, content sits on a card.
    out property <color> chrome: surface-container-low;
    out property <color> card: surface-container-lowest;
}

// M3 Expressive motion: springy spatial curves (they overshoot) and calm effect curves.
export global Motion {
    out property <duration> short: 150ms;
    out property <duration> medium: 280ms;
    out property <duration> long: 450ms;
    out property <duration> spring: 550ms;
}

